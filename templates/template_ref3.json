    "y": 680,
    "align": "right",
    "font_family": "Anton",
    "font_path": "assets/fonts/Anton-Regular.ttf",
    "font_size": 26,
    "fill_color": "rgba(255, 255, 255, 0.40)",
    "shadow": true
  },
  "subtitles": {
