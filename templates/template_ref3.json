  },
  "color_grade": {
    "style": "warm_desaturated_cinematic",
    "contrast": 1.12,
    "saturation": 0.85,
    "shadow_depth": "deep_blacks",
    "temperature": "warm",
    "ffmpeg_eq_filter": "eq=contrast=1.12:saturation=0.85:brightness=-0.02,colorbalance=rs=0.04:gs=0.02:bs=-0.04"
