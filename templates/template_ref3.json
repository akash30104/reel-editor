{
  "template_id": "template_ref3",
  "name": "Reference 3 - Minimalist Motivational Kinetic Short",
  "version": "1.0.0",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background_color": "#000000"
  },
  "camera_and_framing": {
