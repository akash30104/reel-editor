        "crop_w": 2160,
        "crop_h": 1215
      },
      {
        "speaker": "guest",
        "start_sec": 8.0,
        "end_sec": 74.0,
        "crop_x": 190,
        "crop_y": 450,
        "crop_w": 2160,
        "crop_h": 1215
      }
    ],
    "allow_jump_cuts": false,
    "allow_zooms": false,
    "allow_broll": false,
